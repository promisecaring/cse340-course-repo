
<%- include('partials/header', { title: title }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1><%= categoryDetails.name %></h1>
            <p>
                Explore service opportunities in this category
                and find ways to make a difference in your community.
            </p>
        </div>
    </section>

    <section class="container projects-section">
        <div class="section-heading">
            <h2>Projects in <%= categoryDetails.name %></h2>
            <p>
                Discover the service projects available in this category.
            </p>
        </div>

        <div class="project-grid">
            <% if (projects && projects.length > 0) { %>

                <% projects.forEach(project => { %>
                    <article class="project-card">
                        <div class="project-info">

                            <span class="project-category">
                                <%= categoryDetails.name %>
                            </span>

                            <h3>
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                            </h3>

                            <p><%= project.description %></p>

                            <p>
                                <strong>Organization:</strong>
                                <a href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a>
                            </p>

                            <p>
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                            <a
                                href="/project/<%= project.project_id %>"
                                class="btn"
                            >
                                View Project
                            </a>

                        </div>
                    </article>
                <% }) %>

            <% } else { %>

                <p>
                    There are currently no service projects
                    available in this category.
                </p>

            <% } %>
        </div>

        <p>
            <a href="/categories">← Back to All Categories</a>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
