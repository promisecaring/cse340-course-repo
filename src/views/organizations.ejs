
<%- include('partials/header', { title: title }) %>

<section class="page-container">

    <div class="page-banner">
        <div class="banner-content">
            <span class="eyebrow">OUR PARTNERS</span>
            <h1><%= title %></h1>
            <p>
                Meet the organizations working with us to create
                meaningful opportunities and positive change in
                our communities.
            </p>
        </div>
    </div>

    <section class="organizations-section">

        <div class="section-heading">
            <h2>Our Partner Organizations</h2>
            <p>
                Discover the organizations committed to making
                a difference through community service.
            </p>
        </div>

        <% if (organizations && organizations.length > 0) { %>

            <div class="organization-grid">

                <% organizations.forEach((organization) => { %>

                    <article class="organization-card">

                        <div class="organization-image">
                            <img
                                src="/images/<%= organization.logo_filename %>"
                                alt="<%= organization.name %> logo"
                            >
                        </div>

                        <div class="organization-info">

                            <span class="organization-tag">
                                Partner Organization
                            </span>

                            <h3>
    <a href="/organization/<%= organization.organization_id %>">
        <%= organization.name %>
    </a>
</h3>

                            <p><%= organization.description %></p>

                            <a
                                class="contact-link"
                                href="mailto:<%= organization.contact_email %>"
                            >
                                Contact Organization
                            </a>

                        </div>

                    </article>

                <% }); %>

            </div>

        <% } else { %>

            <p>No organizations are currently available.</p>

        <% } %>

    </section>

</section>

<%- include('partials/footer') %>
