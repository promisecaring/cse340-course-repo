
<%- include('partials/header', { title: 'Our Partner Organizations' }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1>Our Partner Organizations</h1>
            <p>Meet the organizations working with us to build stronger communities.</p>
        </div>
    </section>

    <section class="container organizations-section">
        <div class="section-heading">
            <h2>Meet Our Partners</h2>
            <p>Discover the organizations making meaningful contributions.</p>
        </div>

        <div class="organization-grid">

            <article class="organization-card">
                <img src="/images/brightfuture-logo.png"
                     alt="BrightFuture Builders"
                     class="organization-image">
                <div class="card-content">
                    <h3>BrightFuture Builders</h3>
                    <p>
                        BrightFuture Builders supports community development
                        through construction, education, and empowerment initiatives.
                    </p>
                    <a href="mailto:info@brightfuture.org">
                        Contact Organization
                    </a>
                </div>
            </article>

            <article class="organization-card">
                <img src="/images/greenharvest-logo.png"
                     alt="GreenHarvest Growers"
                     class="organization-image">
                <div class="card-content">
                    <h3>GreenHarvest Growers</h3>
                    <p>
                        GreenHarvest Growers promotes sustainable agriculture,
                        environmental awareness, and food security.
                    </p>
                    <a href="mailto:contact@greenharvest.org">
                        Contact Organization
                    </a>
                </div>
            </article>

            <article class="organization-card">
                <img src="/images/unityserve-logo.png"
                     alt="UnityServe Volunteers"
                     class="organization-image">
                <div class="card-content">
                    <h3>UnityServe Volunteers</h3>
                    <p>
                        UnityServe Volunteers brings people together to support
                        local communities through volunteer service.
                    </p>
                    <a href="mailto:hello@unityserve.org">
                        Contact Organization
                    </a>
                </div>
            </article>

        </div>
    </section>

    <section class="call-to-action container">
        <h2>Ready to Make a Difference?</h2>
        <p>Explore our community projects and discover how you can get involved.</p>
        <a href="/projects" class="hero-button">View Our Projects</a>
    </section>
</main>

<%- include('partials/footer') %>
