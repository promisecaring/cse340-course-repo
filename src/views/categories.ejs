
<%- include('partials/header', { title: 'Service Project Categories' }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1>Service Project Categories</h1>
            <p>Explore different ways to make a positive difference in your community.</p>
        </div>
    </section>

    <section class="container projects-section">
        <div class="section-heading">
            <h2>Explore Our Categories</h2>
            <p>Find a service opportunity that matches your interests.</p>
        </div>

        <div class="project-grid">

            <article class="project-card">
                <div class="card-content">
                    <h3>Environmental</h3>
                    <p>
                        Participate in activities that protect the environment,
                        promote sustainability, and keep our communities clean.
                    </p>
                </div>
            </article>

            <article class="project-card">
                <div class="card-content">
                    <h3>Educational</h3>
                    <p>
                        Support learning through tutoring, mentoring,
                        educational programs, and academic assistance.
                    </p>
                </div>
            </article>

            <article class="project-card">
                <div class="card-content">
                    <h3>Community Service</h3>
                    <p>
                        Help strengthen communities through volunteering,
                        outreach programs, and neighborhood improvement.
                    </p>
                </div>
            </article>

            <article class="project-card">
                <div class="card-content">
                    <h3>Health and Wellness</h3>
                    <p>
                        Promote healthier communities through wellness
                        awareness, health education, and support initiatives.
                    </p>
                </div>
            </article>

        </div>
    </section>
</main>

<%- include('partials/footer') %>
