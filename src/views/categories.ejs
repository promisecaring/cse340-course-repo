
<%- include('partials/header', { title: title }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1>Service Categories</h1>
            <p>
                Explore different ways to make a positive difference
                in your community.
            </p>
        </div>
    </section>

    <section class="container projects-section">
        <div class="section-heading">
            <h2>Explore Our Categories</h2>
            <p>Find a service opportunity that matches your interests.</p>
        </div>

        <div class="project-grid">
            <% if (categories && categories.length > 0) { %>

                <% categories.forEach(category => { %>
                    <article class="project-card">
                        <div class="project-info">

                            <span class="project-category">
                                Service Category
                            </span>

                            <h3>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.name %>
                                </a>
                            </h3>

                            <p>
                                Explore service projects available
                                in this category.
                            </p>

                            <a
                                href="/category/<%= category.category_id %>"
                                class="btn"
                            >
                                View Projects
                            </a>

                        </div>
                    </article>
                <% }) %>

            <% } else { %>

                <p>No service categories are currently available.</p>

            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
