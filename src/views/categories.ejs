
<%- include('partials/header', { title: title }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1>Service Categories</h1>
            <p>
                Explore different ways to make a positive difference
                in your community.
            </p>
        </div>
    </section>

    <section class="container projects-section">
        <div class="section-heading">
            <h2>Explore Our Categories</h2>
            <p>Find a service opportunity that matches your interests.</p>
        </div>

        <div class="project-grid">
            <% if (categories && categories.length > 0) { %>

                <% categories.forEach(category => { %>
                    <article class="project-card">
                        <div class="project-info">
                            <span class="project-category">
                                Service Category
                            </span>

                            <h3><%= category.name %></h3>

                            <% if (category.projects.length > 0) { %>
                                <ul class="category-project-list">
                                    <% category.projects.forEach(project => { %>
                                        <li>
                                            <%= project.title %>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p>No projects currently available.</p>
                            <% } %>
                        </div>
                    </article>
                <% }) %>

            <% } else { %>
                <p>No service categories are currently available.</p>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
