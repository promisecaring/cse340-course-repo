
<%- include('partials/header', { title: 'Service Projects' }) %>

<main>
    <section class="page-banner">
        <div class="container">
            <h1>Community Service Projects</h1>
            <p>Discover opportunities to serve, contribute, and transform lives.</p>
        </div>
    </section>

    <section class="container projects-section">
        <div class="section-heading">
            <h2>Explore Our Projects</h2>
            <p>Every act of service helps create a stronger community.</p>
        </div>

        <div class="project-grid">

            <article class="project-card">
                <img src="/images/park-cleanup.png"
                     alt="Volunteers cleaning a community park">
                <div class="card-content">
                    <span class="project-category">Environment</span>
                    <h3>Park Cleanup</h3>
                    <p>
                        Join volunteers in cleaning local parks, removing waste,
                        and creating safer, cleaner recreational spaces.
                    </p>
                    <a href="mailto:hello@unityserve.org">
                        Learn More
                    </a>
                </div>
            </article>

            <article class="project-card">
                <img src="/images/food-drive.jpg"
                     alt="Food donations prepared for distribution">
                <div class="card-content">
                    <span class="project-category">Community Support</span>
                    <h3>Food Drive</h3>
                    <p>
                        Help collect and distribute food supplies to families
                        and individuals experiencing food insecurity.
                    </p>
                    <a href="mailto:contact@greenharvest.org">
                        Learn More
                    </a>
                </div>
            </article>

            <article class="project-card">
                <img src="/images/community-tutoring.png"
                     alt="Volunteer tutoring students">
                <div class="card-content">
                    <span class="project-category">Education</span>
                    <h3>Community Tutoring</h3>
                    <p>
                        Support students through volunteer tutoring, academic
                        guidance, and educational mentoring.
                    </p>
                    <a href="mailto:info@brightfuture.org">
                        Learn More
                    </a>
                </div>
            </article>

        </div>
    </section>

    <section class="call-to-action container">
        <h2>Be Part of Something Meaningful</h2>
        <p>Connect with our partner organizations and find ways to serve.</p>
        <a href="/organizations" class="hero-button">
            Meet Our Partners
        </a>
    </section>
</main>

<%- include('partials/footer') %>
