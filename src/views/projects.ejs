
<%- include('partials/header', { title: 'Service Projects' }) %>

<main>

    <section class="page-banner">
        <div class="container">
            <h1>Community Service Projects</h1>
            <p>
                Discover opportunities to serve, contribute,
                and transform lives.
            </p>
        </div>
    </section>

    <section class="container projects-section">

        <div class="section-heading">
            <h2>Explore Our Projects</h2>
            <p>
                Every act of service helps create a stronger community.
            </p>
        </div>

        <div class="project-grid">

            <% if (projects && projects.length > 0) { %>

                <% projects.forEach(project => { %>

                    <article class="project-card">
                        <div class="project-info">

                            <span class="project-category">
                                <%= project.organization_name %>
                            </span>

                           <h3>
    <%= new Date(project.project_date).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC'
    }) %>:
    <%= project.title %>
    (<%= project.organization_name %>)
</h3>

                            <p>
                                <%= project.description %>
                            </p>

                            <p>
                                <strong>Location:</strong>
                                <%= project.location %>
                            </p>

                           

                        </div>
                    </article>

                <% }) %>

            <% } else { %>

                <p>No service projects are currently available.</p>

            <% } %>

        </div>

    </section>

</main>

<%- include('partials/footer') %>
