<%- include('partials/header', { title: title }) %>

<section class="page-container">

    <div class="page-banner">
        <div class="banner-content">
            <span class="eyebrow">OUR PARTNERS</span>
            <h1>Organization Details</h1>
            <p>
                Learn more about our partner organization and
                the service projects it supports.
            </p>
        </div>
    </div>

    <section class="organizations-section">

        <% if (organizationDetails) { %>

            <article class="organization-card">

                <div class="organization-image">
                    <img
                        src="/images/<%= organizationDetails.logo_filename %>"
                        alt="<%= organizationDetails.name %> logo"
                    >
                </div>

                <div class="organization-info">

                    <span class="organization-tag">
                        Partner Organization
                    </span>

                    <h2><%= organizationDetails.name %></h2>

                    <p><%= organizationDetails.description %></p>

                    <a
                        class="contact-link"
                        href="mailto:<%= organizationDetails.contact_email %>"
                    >
                        Contact Organization
                    </a>

                </div>

            </article>

            <div class="section-heading">
                <h2>Service Projects</h2>
                <p>
                    Explore the service opportunities offered
                    by this organization.
                </p>
            </div>

            <% if (projects && projects.length > 0) { %>

                <div class="project-grid">

                    <% projects.forEach((project) => { %>

                        <article class="project-card">

                            <div class="project-info">

                                <span class="project-category">
                                    Service Project
                                </span>

                                <h3>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </h3>

                                <p><%= project.description %></p>

                                <p>
                                    <strong>Location:</strong>
                                    <%= project.location %>
                                </p>

                            </div>

                        </article>

                    <% }); %>

                </div>

            <% } else { %>

                <p>No service projects are currently available for this organization.</p>

            <% } %>

        <% } else { %>

            <h2>Organization Not Found</h2>

            <p>The organization you are looking for does not exist.</p>

        <% } %>

        <p>
            <a href="/organizations">Back to Organizations</a>
        </p>

    </section>

</section>

<%- include('partials/footer') %>